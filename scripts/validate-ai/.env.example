# Get from console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-api03-...

# WP install to validate against. Use the local dev site you ran the
# onboarding wizard against (sharp-again.local works).
WP_URL=https://sharp-again.local
WP_USER=admin
WP_PASSWORD=your application password (spaces ok)

# Page path on the WP site, relative to the host. "/" for the homepage.
WP_PAGE_PATH=/

# Ability prefix in the WP plugin manifest. "jab/" for the rebranded plugin
# (0.2.0+); "skm/" for the pre-rebrand plugin; empty to fetch all public
# abilities.
ABILITY_PREFIX=jab/

# Set to "1" only if WP_URL has a self-signed cert (Local by Flywheel etc.).
# DEV ONLY — never set in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
