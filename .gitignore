# Dependencies
node_modules/
vendor/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# CLI local state (jab init writes .jab/config.json + manifest.json; .skm/ is
# the pre-rebrand name still left over in some checkouts). jab generate run
# against the CLI's own dir writes packages/cli/lib/ — not source, just probe
# output. Real CLI source ships from packages/cli/dist/ per package.json files.
.jab/
.skm/
packages/cli/lib/

# Environment + local config
.env
.env.local
.env.*.local
*.local

# MCP config (carries a Supabase PAT — never commit). The file is checked
# into a developer's local repo for Claude Code's MCP discovery; replicate
# from .mcp.json.example for new clones.
.mcp.json

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Pilot output (gitignored per CLAUDE.md — kept private)
pilots/*/
!pilots/.gitkeep

# Local debugging workspaces + Vite cache (jab-fix-build.ts et al. write here)
.vite/
apps/web/.jab-fix/
apps/web/.jab-fix-src/
apps/web/.jab-inspect/
apps/web/scripts/_scratch/

# Claude Code local session settings (project skills/settings, if added later,
# get un-ignored deliberately)
.claude/settings.local.json
.claude/worktrees/
