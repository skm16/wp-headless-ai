{
    "name": "jab/wp-headless-kit",
    "description": "Exposes WordPress content as MCP abilities for headless, AI-iterable frontends.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "automattic/jetpack-autoloader": "^5.0 || ^4.0 || ^3.0",
        "wordpress/abilities-api": "^0.4",
        "wordpress/mcp-adapter": "^0.5"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.9",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Jab\\WpHeadlessKit\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jab\\WpHeadlessKit\\Tests\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "autoloader-suffix": "JabWpHeadlessKit"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test:unit": "phpunit --configuration tests/phpunit-unit.xml.dist"
    }
}
