<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pure-unit test config. Runs tests under tests/unit/ that exercise plugin
  logic without booting a real WordPress instance. WP functions are stubbed
  in tests/bootstrap.php — that's enough for capability gates, name dedupe,
  format validation, and date resolution.

  The integration suite (tests against a real WP_Query, real ACF, real
  permission_callback) is a separate config — PROC-1 follow-up.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="bootstrap.php"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    failOnRisky="true"
    failOnWarning="true"
    cacheResultFile="../.phpunit.cache/test-results"
>
    <testsuites>
        <testsuite name="unit">
            <directory>unit</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">../includes</directory>
        </include>
    </coverage>
</phpunit>
