# Server-only WP credentials. NEVER add NEXT_PUBLIC_ prefix to any of these —
# that would leak them into the browser bundle.

WP_URL=https://your-site.com
WP_USER=your-wp-username
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# For LocalWP / self-signed certs only. Remove for production.
# NODE_TLS_REJECT_UNAUTHORIZED=0
