{
  "name": "@skm/wp-headless-cli",
  "version": "0.1.0",
  "description": "CLI generator that turns a WordPress site exposing the MCP Adapter into a typed Next.js project for AI-iterable headless development.",
  "keywords": [
    "wordpress",
    "headless",
    "nextjs",
    "mcp",
    "claude-code",
    "ai",
    "scaffolding",
    "cli",
    "code-generation",
    "abilities-api"
  ],
  "homepage": "https://github.com/skm16/wp-headless-ai#readme",
  "bugs": {
    "url": "https://github.com/skm16/wp-headless-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skm16/wp-headless-ai.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wpheadless": "./bin/wpheadless.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "json-schema-to-typescript": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
